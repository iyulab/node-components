{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // 배포용 산출물. 소비 패키지의 vite.config 가 이 플러그인을 **패키지 이름으로**
    // 임포트하므로(`@iyulab/components/plugins/…js`), 게시본에 실행 가능한 .js 가 있어야 한다.
    //
    // ⚠산출물을 `plugins/` 옆이 아니라 **`dist/plugins/` 로** 낸다. 예전에 옆에 두었을 때
    // vite.config 의 확장자 없는 상대 임포트가 **컴파일된 .js 를 .ts 소스보다 먼저 잡아**,
    // 로컬만 낡은 산출물을 쓰는 괴리가 생겼다(`tsconfig.json` 주석 참조). 위치를 가르면
    // 소스가 유일한 진실로 남으면서 게시본도 동작한다.
    "noEmit": false,
    "declaration": true,
    "outDir": "../dist/plugins"
  }
}
