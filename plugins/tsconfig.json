{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    // 타입 검사만 한다 — 산출물을 내보내지 않는다.
    //
    // 예전에는 declaration 과 함께 .js/.d.ts 를 plugins/ 에 emit 했는데, vite.config.ts 가
    // 확장자 없이 './plugins/vite-plugin-react-wrapper' 를 임포트하므로 Vite 해석 순서상
    // **컴파일된 .js 가 .ts 소스를 가렸다**. 그 결과 ⑴플러그인 수정이 다음 빌드에야 반영되고
    // (build 스크립트가 vite build 뒤에 컴파일했다) ⑵산출물이 없는 신규 클론/CI 는 .ts 를
    // 쓰는데 로컬만 낡은 .js 를 쓰는 괴리가 생겼다. emit 을 없애 소스가 유일한 진실이 된다.
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"]
}
