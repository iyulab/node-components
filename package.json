{
  "name": "@iyulab/components",
  "description": "web-components library based on lit-element made by iyulab",
  "version": "1.25.0",
  "keywords": [
    "iyulab",
    "components",
    "web-components",
    "lit",
    "lit-element"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-components.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "./src/components/*/U*.ts",
    "./dist/components/*/U*.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./dist/*": "./src/*",
    "./react": "./dist/react/index.js",
    "./react/*": "./dist/react/*",
    "./styles/*": "./dist/styles/*",
    "./plugins/*": "./dist/plugins/*"
  },
  "scripts": {
    "start": "vite --force",
    "test": "vitest run",
    "test:browser": "vitest run --project=browser",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "npm run typecheck && eslint && npm run typecheck:plugins && vite build && npm run build:plugins && npm run test:react-types",
    "test:react-types": "tsc -p tsconfig.react-smoke.json",
    "typecheck:plugins": "tsc -p plugins/tsconfig.json",
    "docs:cssprops": "node scripts/cssprops-doc.mjs --write",
    "docs:react-events": "node scripts/react-events-doc.mjs --write",
    "docs:tokens": "node scripts/design-tokens-doc.mjs --write",
    "build:plugins": "tsc -p plugins/tsconfig.build.json",
    "probe:seed-ramp": "node scripts/seed-ramp.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "focus-trap": "^8.2.2",
    "glob": "^13.0.6",
    "lit": "^3.3.3",
    "tabbable": "^6.5.0"
  },
  "peerDependencies": {
    "@lit/react": ">=1.0.8",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.7.0",
    "react": "^19.2.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
